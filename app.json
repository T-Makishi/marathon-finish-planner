{
  "expo": {
    "name": "RUN Finish Planner",
    "slug": "marathon-finish-planner",
    "version": "2.2.7",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f5f6f1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.local.marathonfinishplanner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.local.marathonfinishplanner"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "icon": "./assets/favicon.png"
  }
}
